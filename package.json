{
  "name": "middle.messenger.praktikum.yandex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc --noEmit",
    "build": "npm run prebuild && vite build",
    "start": "npm run build && vite preview --port 3000 --strictPort",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,css,scss,md}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test": "mocha --config .mocharc.json",
    "test:watch": "mocha --config .mocharc.json --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "chai": "^6.2.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^15.5.0",
    "mocha": "^11.7.5",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "sass": "^1.89.2",
    "stylelint": "^16.23.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4"
  },
  "dependencies": {
    "express": "^4.18.0",
    "handlebars": "^4.7.8",
    "uuid": "^13.0.0"
  },
  "lint-staged": {
    "**/*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ],
    "**/*.hbs": [
      "prettier --write"
    ]
  }
}
