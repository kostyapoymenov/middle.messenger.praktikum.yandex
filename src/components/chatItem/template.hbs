<div class="chat-item__body">
  {{{avatar}}}
  <div class="chat-item__content">
    <div class="chat-item__name">{{chatName}}</div>
    <div class="chat-item__message">{{chatMessage}}</div>
  </div>
</div>
<div class="chat-item__info">
  <div class="chat-item__date">
    <span>{{chatTime}}</span>
  </div>
  <div class="chat-item__count">
    <span class="chat-item__count-circle">{{unreadCount}}</span>
  </div>
</div>
